  {
   "id": "reg_25",
   "label": "text_line",
   "bbox": [
    329.1,
    427.0,
    1716.9,
    71.9
   ],
   "text": "جملم تعلقین کومطلع کیاجاتا ہے کہ امتحان ٹانوی فرسٹ اینول 2026 ء کا آغاز ماہ مارچ 2026ء کے پہلے ہفتہ سے ہونا متوقع ہے۔ Online داخلہ فارم فیڈ کرنے ،اورفیس داخلہ جمع",
   "flags": []
  },
  {
   "id": "reg_26",
   "label": "text_line",
   "bbox": [
    334.1,
    497.9,
    1908.1,
    63.2
   ],
   "text": "کروانے کے بعد فارم داخلہ کی ہارڈ کا بی وفیس کا جالا ن/رسیددرج ذیل شیڈول کے مطابق دفتر بورڈ میں وصول کیے جائیں گے۔شیڈول حتمی تصور ہو۔اس میں کسی تتم کی توسیع نہ ہوگ اور تیسرے مرحلے کے",
   "flags": []
  },
  {
   "id": "reg_27",
   "label": "text_line",
   "bbox": [
    1638.0,
    572.0,
    606.1,
    53.0
   ],
   "text": "اختام کے بعد کسی بھی صورت فارم داخلہ قابل قبول نہوں گے۔",
   "flags": []
  },
  {
   "id": "reg_4",
   "label": "table",
   "bbox": [
    336.5,
    618.6,
    1894.0,
    291.2
   ],
   "text": "",
   "flags": []
  },
  {
   "id": "reg_28",
   "label": "text_line",
   "bbox": [
    1465.9,
    634.1,
    540.9,
    51.9
   ],
   "text": "آن لائن فارم فید تک اورفیس داخلہ جع کروانی کاتواریخ",
   "flags": []
  },
  {
   "id": "reg_29",
   "label": "text_line",
   "bbox": [
    846.9,
    635.8,
    403.0,
    49.8
   ],
   "text": "فارم داخلہ/ بارؤ کالی دفتر بورؤش دی جمع",
   "flags": []
