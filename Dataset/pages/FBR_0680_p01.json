    1600.9,
    84.9
   ],
   "text": "S.R.O.18(I)/2019-کسٹزا یکٹ،1969(VI بابت 1969) کی د فعہ 19 پڑھیے بشمول سیلز ٹیکس،1990 کی د فعہ",
   "flags": []
  },
  {
   "id": "reg_3",
   "label": "reference_no",
   "bbox": [
    446.0,
    1027.6,
    1590.0,
