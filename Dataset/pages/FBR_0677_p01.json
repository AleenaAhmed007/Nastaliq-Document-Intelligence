   ],
   "text": "اختیارات بروئے کارلاتے ہوئے،وفاقی حکومت ہدایت کرتی ہے کہ اس کے نوٹیفکیشن نمبر 2018/(1)S.R.O.630،",
   "flags": []
  },
  {
   "id": "reg_20",
   "label": "text_line",
   "bbox": [
    796.0,
    1228.9,
    1245.0,
    72.9
   ],
   "text": "مور خہ 24۔مئ 2018ء کی د فعہ 18 کی ذیلی د فعہ (5) میں درج ذیل ترمیم کی جائے گی، یعنی:۔",
   "flags": []
